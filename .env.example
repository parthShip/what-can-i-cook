# Copy to .env.local and fill in. .env.local is gitignored.
#
#   cp .env.example .env.local
#
# Never put real values in THIS file - it is committed.

# Google AI Studio - free tier: https://aistudio.google.com/apikey
# Used for BOTH chat (gemini-3.6-flash) and embeddings (gemini-embedding-001).
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-studio-key

# Supabase - Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key. Server-only: it bypasses RLS, so never prefix it NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct Postgres connection, used only by `npm run db:push` to apply supabase/schema.sql.
# Supabase > Project Settings > Database > Connection string > Session pooler (port 5432).
# The transaction pooler (6543) rejects DDL. Contains your DB password - server-only.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres
